    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\go\analyzed_program.go" Link="analyzed_program.go" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
